      "name": "Recuperar Senha - Campo E-mail Vazio",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status Code deve ser 400\", function () {\r",
              "    pm.response.to.have.status(400);\r",
              "});\r",
              "\r",
              "pm.test(\"Tempo de resposta menor que 1000 ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
              "});\r",
              "pm.test(\"Resposta deve estar em formato JSON\", function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"Mensagem 'O campo Email é obrigatório.' deve ser exibida\", function () {\r",
              "    pm.expect(response.message).to.include(\"O campo Email é obrigatório.\");\r",
              "});"
