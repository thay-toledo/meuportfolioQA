  "item": [
    {
      "name": "Redefinir senha com sucesso",
      "item": [
        {
          "name": "Recuperar Senha - E-mail Válido - Mensagem Link Enviado Copy",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let response = pm.response.json();\r",
                  "\r",
                  "// status\r",
                  "pm.test(\"Status Code é 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Mensagem\r",
                  "pm.test(\"Mensagem de sucesso\", function () {\r",
                  "    pm.expect(response.message).to.eql(\"Um link de recuperação foi enviado.\");\r",
                  "});\r",
                  "\r",
                  "// Tempo de resposta\r",
                  "pm.test(\"Tempo de resposta menor que 2 segundos\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "\r",
                  "// Content-Type\r",
                  "pm.test(\"Retorna JSON\", function () {\r",
                  "    pm.response.to.have.header(\"Content-Type\");\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
