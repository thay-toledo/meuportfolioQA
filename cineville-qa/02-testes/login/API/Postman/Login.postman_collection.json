{
  "info": {
    "_postman_id": "9f955bba-6454-4dfe-b74d-77d2461de6e4",
    "name": "Login",
    "description": "Requisição tem como objetivo autenticar um usuário no sistema utilizando e-mail e senha. Quando as credenciais são válidas, a API retorna um token de autenticação (JWT), que será utilizado para acessar endpoints protegidos.\n\n**Principais validações**\n\nStatus Code  \nTempo de resposta  \nContent-Type  \nExistência do token  \nToken não vazio  \nToken é uma string  \nMensagem de sucesso.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "52675394",
    "_collection_link": "https://go.postman.co/collection/52675394-9f955bba-6454-4dfe-b74d-77d2461de6e4?source=collection_link"
  },
  "item": [
    {
      "name": "Login - Senha inválida",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let response = pm.response.json();\r",
              "\r",
              "// 1. Status Code\r",
              "pm.test(\"Status Code deve ser 401\", function () {\r",
              "    pm.response.to.have.status(401);\r",
              "});\r",
              "\r",
              "// 2. Mensagem de erro\r",
              "pm.test(\"Mensagem de erro correta\", function () {\r",
              "    pm.expect(response.message).to.eql(\"E-mail ou senha incorretos.\");\r",
              "});\r",
              "\r",
              "// 3. Content-Type\r",
              "pm.test(\"Content-Type é application/json\", function () {\r",
              "    pm.expect(pm.response.headers.get(\"Content-Type\"))\r",
              "        .to.include(\"application/json\");\r",
              "});\r",
              "\r",
              "// 4. Não retorna token\r",
              "pm.test(\"Não retorna token\", function () {\r",
              "    pm.expect(response.data).to.be.undefined;\r",
              "});\r",
              "\r",
              "// 5. Tempo de resposta\r",
              "pm.test(\"Tempo de resposta menor que 3000 ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"email\": \"valeuteste@gmail.com\",\r\n    \"password\": \"xxxcerto123@\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{url}}/login",
          "host": [
            "{{url}}"
          ],
          "path": [
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Login-Sucesso",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "let response = pm.response.json();\r",
              "\r",
              "pm.test(\"Status Code deve ser 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Tempo de resposta menor que 627 ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(627);\r",
              "});\r",
              "\r",
              "pm.test(\"Content-Type é application/json\", function () {\r",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
              "});\r",
              "\r",
              "pm.test(\"Token existe\", function () {\r",
              "    pm.expect(response.data).to.have.property(\"token\");\r",
              "});\r",
              "\r",
              "pm.test(\"Token não está vazio\", function () {\r",
              "    pm.expect(response.data.token).to.not.be.empty;\r",
              "});\r",
              "\r",
              "pm.test(\"Token é uma string\", function () {\r",
              "    pm.expect(response.data.token).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "pm.test(\"Mensagem de sucesso\", function () {\r",
              "    pm.expect(response.message).to.eql(\"Login realizado com sucesso.\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
