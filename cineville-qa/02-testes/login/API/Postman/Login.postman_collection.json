    {
      "name": "requisição de 5 tentativas login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "\r",
              "// Validação do Content-Type\r",
              "pm.test(\"Content-Type é application/json\", function () {\r",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
              "});\r",
              "\r",
              "// Validação do tempo de resposta\r",
              "pm.test(\"Tempo de resposta menor que 1000 ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
              "});\r",
              "\r",
              "// Controle da quantidade de tentativas\r",
              "let count = pm.collectionVariables.get(\"loginAttempts\");\r",
              "\r",
              "count = count ? Number(count) + 1 : 1;\r",
              "\r",
              "pm.collectionVariables.set(\"loginAttempts\", count);\r",
              "\r",
              "// Validações\r",
              "if (count < 6) {\r",
              "\r",
              "    pm.test(`Tentativa ${count} deve retornar 401`, function () {\r",
              "        pm.response.to.have.status(401);\r",
              "    });\r",
              "\r",
              "} else {\r",
              "\r",
              "    pm.test(`Tentativa ${count} deve retornar 429`, function () {\r",
              "        pm.response.to.have.status(429);\r",
              "    });\r",
              "\r",
              "    pm.test(\"Mensagem de erro deve ser 'ThrottlerException: Too Many Requests'\", function () {\r",
              "        pm.expect(response.message).to.eql(\"ThrottlerException: Too Many Requests\");\r",
              "    });\r",
              "\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
